#!/bin/sh
set -eu

OPENAPI_GENERATOR_CLI_IMAGE=${OPENAPI_GENERATOR_CLI_IMAGE:-openapitools/openapi-generator-cli:v7.10.0}
OPENAPI_SPEC_FILE=${OPENAPI_SPEC_FILE:-data/open_api_spec.yaml}

metadata=$(cat <<'EOF'
authors = ["Jesse Luehrs <doy@tozt.net>", "You Need A Budget, LLC"]
description = "OpenAPI-generated API bindings for the YNAB API"
repository = "https://git.tozt.net/ynab-api"
license = "Apache-2.0"
EOF
)

extra_readme=$(cat <<'EOF'
Jesse Luehrs <doy@tozt.net>

Based on the OpenAPI spec found at https://github.com/ynab/ynab-sdk-js/blob/main/open_api_spec.yaml by You Need A Budget, LLC
EOF
)

cd "$(dirname "$0")/.."

rm -rf src docs

command -v docker >/dev/null 2>&1 || {
    echo >&2 "docker is required (set OPENAPI_GENERATOR_CLI_IMAGE to override the image)"
    exit 1
}

test -f "$OPENAPI_SPEC_FILE" || {
    echo >&2 "OpenAPI spec not found: $OPENAPI_SPEC_FILE"
    exit 1
}

docker run --rm \
    --user "$(id -u):$(id -g)" \
    -e HOME=/tmp \
    -v "$(pwd):/work" \
    -w /work \
    "$OPENAPI_GENERATOR_CLI_IMAGE" \
    generate \
    -g rust \
    --library reqwest \
    -i "$OPENAPI_SPEC_FILE" \
    -c data/openapi.yaml \
    --package-name ynab-api

echo "$metadata" | perl -i -ne '
BEGIN {
    $meta = do { local $/; <STDIN> };
    $in_package = 0;
    $inserted = 0;
}

if (/^\[package\]$/) {
    $in_package = 1;
} elsif ($in_package && /^\[/) {
    $in_package = 0;
}

if ($in_package) {
    if (!$inserted && /^authors\s*=/) {
        print $meta;
        $inserted = 1;
        next;
    }

    if ($inserted) {
        next if /^(authors|description|repository|license)\s*=/;
        next if /^# Override this license\b/;
    }
}

print;
' Cargo.toml
echo "$extra_readme" >> README.md

# Ensure there aren't leftover files under src/ or docs/ that are no longer
# generated by openapi-generator (those can confuse diffs and break builds).
manifest="$(mktemp)"
tree="$(mktemp)"
grep -E '^(src|docs)/' .openapi-generator/FILES | sort > "$manifest"
find src docs -type f | sed 's|^\./||' | sort > "$tree"

extra="$(comm -13 "$manifest" "$tree")"
missing="$(comm -23 "$manifest" "$tree")"

rm -f "$manifest" "$tree"

if [ -n "$extra" ]; then
    echo >&2 "Unexpected files found under src/ or docs/:"
    echo >&2 "$extra"
    exit 1
fi

if [ -n "$missing" ]; then
    echo >&2 "Files listed in .openapi-generator/FILES are missing:"
    echo >&2 "$missing"
    exit 1
fi
